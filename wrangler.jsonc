{
  "name": "selladshot",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "keep_vars": true,
  "vars": {
    "RESEND_FROM": "SellAdShot <hello@send.selladshot.com>",
    "ALLOW_PREVIEW": "1"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
